# SPDX-License-Identifier: MIT
# Extras for the 60% keyboard on the S2 mini: knob with modes, Raw HID with PC data, custom screen.

config S2MINI_KNOB_MODES
    bool "Knob with modes (&knob, &knob_next)"
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_KNOB_MODES_ENABLED

config S2MINI_RAW_HID
    bool "Raw HID: data from the PC for the screen"
    depends on ZMK_USB_NEXT && USBD_HID_SUPPORT
    help
      Second HID interface (usage page 0xFF60, 32 B reports). Needs a zephyr,hid-device node
      selected with chosen s2mini,raw-hid.

config S2MINI_RAW_HID_INIT_PRIORITY
    int "Raw HID init priority"
    default 94
    depends on S2MINI_RAW_HID

config S2MINI_STATUS_SCREEN
    bool "S2 mini 60% screen (layer, knob, data from the PC)"
    depends on ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select LV_USE_THEME_MONO

config S2MINI_STATUS_PC_TIMEOUT_MS
    int "Milliseconds without PC data before the screen shows 'no data from PC'"
    default 5000
    depends on S2MINI_STATUS_SCREEN
