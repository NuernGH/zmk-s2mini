# Dodatki dla klawiatury 60% na S2 mini: gałka z trybami, Raw HID z danymi z PC, własny ekran.

config S2MINI_KNOB_MODES
    bool "Gałka z trybami (&knob, &knob_next)"
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_KNOB_MODES_ENABLED

config S2MINI_RAW_HID
    bool "Raw HID: dane z PC dla ekranu"
    depends on ZMK_USB_NEXT && USBD_HID_SUPPORT
    help
      Drugi interfejs HID (strona 0xFF60, raporty 32 B). Wymaga węzła zephyr,hid-device
      wskazanego przez chosen s2mini,raw-hid.

config S2MINI_RAW_HID_INIT_PRIORITY
    int "Raw HID init priority"
    default 94
    depends on S2MINI_RAW_HID

config S2MINI_STATUS_SCREEN
    bool "Ekran 60% S2 mini (warstwa, gałka, dane z PC)"
    depends on ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_USE_LABEL
    select LV_USE_THEME_MONO

config S2MINI_STATUS_PC_TIMEOUT_MS
    int "Po ilu ms bez danych z PC ekran pokazuje 'no data from PC'"
    default 5000
    depends on S2MINI_STATUS_SCREEN
