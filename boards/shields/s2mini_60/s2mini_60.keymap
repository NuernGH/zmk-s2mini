/*
 * 60% ANSI on the S2 mini: layers BASE, GAME, FN; knob with modes and OLED module buttons.
 * The last row of the keymap is the module buttons: PUSH (knob), CON, BAK.
 *
 * Buttons next to the screen (no Fn; tap / hold for more than 0.3 s):
 * PUSH       = next knob mode: VOLUME → SCROLL → TRACK → BRIGHT / mute
 * CON        = previous screen view / play-pause
 * BAK        = next screen view / next track
 * Fn + G     = GAME mode (on/off): Win does nothing, Caps Lock sends F13
 *              (bindable in games, does not change letter case)
 * Fn + \     = unlock ZMK Studio
 *
 * Layer names (display-name) are shown on the screen; change them here or in ZMK Studio.
 * Knob mode names are in the knob node (mode-names).
 * SPDX-License-Identifier: MIT
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/s2mini.h>

/ {
    behaviors {
        knob_vol: knob_vol {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };
        knob_scroll: knob_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <30>;
        };
        knob_track: knob_track {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_NEXT>, <&kp C_PREV>;
        };
        knob_bright: knob_bright {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_BRI_UP>, <&kp C_BRI_DN>;
        };
        knob: knob {
            compatible = "zmk,behavior-knob-modes";
            #sensor-binding-cells = <0>;
            display-name = "Knob";
            modes = <&knob_vol &knob_scroll &knob_track &knob_bright>;
            mode-names = "VOLUME", "SCROLL", "TRACK", "BRIGHT";
        };
        knob_next: knob_next {
            compatible = "zmk,behavior-knob-next";
            #binding-cells = <0>;
            display-name = "Knob mode";
        };
        scr_view: scr_view {
            compatible = "zmk,behavior-screen-view";
            #binding-cells = <1>;
            display-name = "Screen view";
        };
        /* Buttons next to the screen: tap = screen/knob, hold = media */
        push_ht: push_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Knob button";
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&knob_next>;
        };
        view_ht: view_ht {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Screen button";
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&scr_view>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&kp ESC   &kp N1   &kp N2   &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9    &kp N0   &kp MINUS &kp EQUAL &kp BSPC
&kp TAB   &kp Q    &kp W    &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O     &kp P    &kp LBKT  &kp RBKT  &kp BSLH
&kp CAPS  &kp A    &kp S    &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L     &kp SEMI &kp SQT   &kp RET
&kp LSHFT &kp Z    &kp X    &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
&kp LCTRL &kp LGUI &kp LALT &kp SPACE &kp RALT &kp RGUI &mo 2 &kp RCTRL
&push_ht C_MUTE 0 &view_ht C_PP SCR_PREV &view_ht C_NEXT SCR_NEXT
            >;
            sensor-bindings = <&knob>;
        };

        game_layer: game {
            display-name = "GAME";
            bindings = <
&trans    &trans   &trans   &trans &trans &trans &trans &trans &trans &trans    &trans   &trans    &trans    &trans
&trans    &trans   &trans   &trans &trans &trans &trans &trans &trans &trans    &trans   &trans    &trans    &trans
&kp F13   &trans   &trans   &trans &trans &trans &trans &trans &trans &trans    &trans   &trans    &trans
&trans    &trans   &trans   &trans &trans &trans &trans &trans &trans &trans    &trans   &trans
&trans    &none    &trans   &trans &trans &none  &trans &trans
&trans    &trans   &trans
            >;
        };

        fn {
            display-name = "FN";
            bindings = <
&kp GRAVE &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &kp F7    &kp F8    &kp F9     &kp F10   &kp F11 &kp F12 &kp DEL
&trans    &trans &trans &trans &trans &trans &trans  &kp PG_UP &kp UP    &kp PG_DN  &kp PSCRN &trans  &trans  &studio_unlock
&trans    &trans &trans &trans &trans &tog 1 &kp HOME &kp LEFT &kp DOWN  &kp RIGHT  &kp END   &trans  &trans
&trans    &trans &trans &trans &trans &trans &trans  &trans    &trans    &trans     &trans    &trans
&trans    &trans &trans &trans &trans &trans &trans  &trans
&trans    &trans     &trans
            >;
        };
    };
};
